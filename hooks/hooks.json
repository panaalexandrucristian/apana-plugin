{
  "description": "Guidance and scope hooks through the command adapter, plus the native bridge for explicitly requested compact-session. Local work only; no model calls.",
  "modules": ["./compact-session.ts"],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/apana-hook.mjs\" UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep|Read|Glob|Edit|Write|NotebookEdit|AskUserQuestion|Agent|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/apana-hook.mjs\" PreToolUse",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
