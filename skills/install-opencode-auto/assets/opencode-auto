#!/bin/sh
# opencode-auto: starts `opencode` so that its session hands itself off to a new one before the context fills up.
#
#   opencode-auto [any opencode arguments]
#
# It only sets APANA_OPENCODE_AUTO=1 for the TUI it starts and runs `opencode` with your arguments. The TUI part of the apana-auto plugin sees the
# variable and marks the sessions you open in that window; the server part (which never sees the variable) acts on the marked sessions only. A plain
# `opencode` is never affected. Handoffs also need the `enabled` file that the install-opencode-auto skill creates (removing it stops them at once).
#
# Settings, all optional; export them before running or put them in front of the command (for example `APANA_OPENCODE_AUTO_TOKENS=120000 opencode-auto`):
#   APANA_OPENCODE_AUTO_TOKENS         context size at which a session is handed off (default 200000; never above OpenCode's compaction ceiling minus the margin)
#   APANA_OPENCODE_AUTO_PRETOOL_MARGIN a tool call is refused and the handoff starts this many tokens earlier (default 15000)
#   APANA_OPENCODE_AUTO_DEFER_EXTRA    running subagents hold the handoff back by up to this many extra tokens (default 30000)
#   APANA_OPENCODE_AUTO_COOLDOWN       seconds between handoffs in the same chain (default 60)
#   APANA_OPENCODE_AUTO_MAX            handoffs in a chain, 0 for no limit (default 0)
#   APANA_OPENCODE_AUTO_SKILLS         skills the new session reloads: none, all, or names separated by commas (default none; caveman is kept when it was loaded)
#   APANA_OPENCODE_AUTO_DIR            folder for the handoff notes (default ~/.local/share/opencode/apana/handoffs/auto)
# The settings are written on each session when it is marked, so a change reaches new and newly opened sessions, not ones that are already marked.
if ! command -v opencode >/dev/null 2>&1; then
  echo "opencode-auto: \`opencode\` is not on PATH" >&2
  exit 127
fi
APANA_OPENCODE_AUTO=1
export APANA_OPENCODE_AUTO
exec opencode "$@"
