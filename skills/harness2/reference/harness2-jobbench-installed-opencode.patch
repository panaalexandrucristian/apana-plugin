@@ -0,0 +1,69 @@
+"""Substitute OpenCode for the upstream JobBench judge's completion client."""
+
+import base64
+import json
+import os
+import runpy
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+from types import SimpleNamespace
+
+from ..config import scrub_env
+from ..core.proposer import _opencode_stdout
+from .jb_opencode_runner import installed_opencode
+
+
+def complete(*, model, messages, timeout, extra_body=None, **_):
+    executable = installed_opencode()
+    if not executable or "/" not in model:
+        raise ValueError("The JobBench OpenCode judge needs an executable and a provider/model")
+    effort = (extra_body or {}).get("reasoning_effort")
+    model = f"{model}#{effort}" if effort else model
+    with tempfile.TemporaryDirectory(prefix="jb-oc-judge-") as tmp:
+        work = Path(tmp)
+        cmd = [executable, "run", "--standalone", "--format", "json", "--model", model]
+        prompt = []
+        for message in messages:
+            prompt.append(f"## {message['role']} instructions")
+            content = message["content"]
+            if isinstance(content, str):
+                prompt.append(content)
+                continue
+            for part in content:
+                if part["type"] == "text":
+                    prompt.append(part["text"])
+                elif part["type"] == "image_url":
+                    header, encoded = part["image_url"]["url"].split(",", 1)
+                    extensions = {
+                        "data:image/png;base64": "png", "data:image/jpeg;base64": "jpg",
+                        "data:image/gif;base64": "gif", "data:image/webp;base64": "webp",
+                    }
+                    path = work / f"attachment-{len(cmd)}.{extensions[header]}"
+                    path.write_bytes(base64.b64decode(encoded, validate=True))
+                    cmd.extend(["--file", str(path)])
+                else:
+                    raise ValueError("Unsupported JobBench judge message part")
+        env = scrub_env()
+        env["OPENCODE_PERMISSION"] = json.dumps({"*": "deny"})
+        result = subprocess.run(cmd, input="\n\n".join(prompt), cwd=work, env=env,
+                                text=True, capture_output=True, timeout=timeout)
+    text, error = _opencode_stdout(result.stdout)
+    if result.returncode or error or not text.strip():
+        raise RuntimeError(f"OpenCode judge returned no usable response (exit {result.returncode})")
+    return SimpleNamespace(choices=[SimpleNamespace(message=SimpleNamespace(content=text))])
+
+
+def main():
+    judge_path = sys.argv.pop(1)
+    upstream = runpy.run_path(judge_path)["main"]
+    # Keep extraction, rubric prompts, parsing, retries and scoring upstream.
+    upstream.__globals__["get_openai_client"] = lambda *_: SimpleNamespace(
+        chat=SimpleNamespace(completions=SimpleNamespace(create=complete))
+    )
+    upstream()
+
+
+if __name__ == "__main__":
+    main()
