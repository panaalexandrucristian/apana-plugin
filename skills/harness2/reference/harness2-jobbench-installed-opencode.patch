diff --git a/tests/test_jobbench_opencode_roles.py b/tests/test_jobbench_opencode_roles.py
new file mode 100644
index 0000000..f25ac22
--- /dev/null
+++ b/tests/test_jobbench_opencode_roles.py
@@ -0,0 +1,50 @@
+import json
+import os
+import tempfile
+import unittest
+from pathlib import Path
+from subprocess import CompletedProcess
+from unittest.mock import patch
+
+from harness2.benchmarks import jb_opencode_judge
+from harness2.core.proposer import Proposer
+from harness2.core.spec import ChannelSpec
+
+
+def text_event(text):
+    return json.dumps({"type": "text", "part": {"type": "text", "text": text}})
+
+
+class InstalledOpencodeRoles(unittest.TestCase):
+    def test_proposer_uses_installed_binary_and_subscription_profile(self):
+        with tempfile.TemporaryDirectory() as tmp, patch.dict(os.environ, {
+            "HARNESS2_INSTALLED_OPENCODE": "/opt/opencode",
+            "XDG_DATA_HOME": "/isolated/profile",
+        }), patch("harness2.core.proposer.subprocess.run") as run:
+            run.return_value = CompletedProcess([], 0, text_event("proposal"), "")
+            proposer = Proposer(ChannelSpec("opencode", "github-copilot/model", effort="medium"))
+            answer, _, error = proposer._opencode(Path(tmp), "mission", "", 10)
+
+        self.assertEqual((answer, error), ("proposal", ""))
+        argv = run.call_args.args[0]
+        self.assertEqual(argv[0], "/opt/opencode")
+        self.assertIn("--standalone", argv)
+        self.assertIn("github-copilot/model#medium", argv)
+        self.assertEqual(run.call_args.kwargs["env"]["XDG_DATA_HOME"], "/isolated/profile")
+
+    def test_judge_sends_rubric_via_stdin_without_api_key(self):
+        with patch.object(jb_opencode_judge, "installed_opencode", return_value="/opt/opencode"), \
+             patch.dict(os.environ, {"OPENAI_API_KEY": "not-for-judge"}), \
+             patch.object(jb_opencode_judge.subprocess, "run") as run:
+            run.return_value = CompletedProcess([], 0, text_event('{"rubric_passed":true}'), "")
+            result = jb_opencode_judge.complete(
+                model="openai/model", messages=[{"role": "user", "content": "grade this"}],
+                timeout=10, extra_body={"reasoning_effort": "low"},
+            )
+
+        argv = run.call_args.args[0]
+        self.assertIn("openai/model#low", argv)
+        self.assertNotIn("--auto", argv)
+        self.assertIn("grade this", run.call_args.kwargs["input"])
+        self.assertNotIn("OPENAI_API_KEY", run.call_args.kwargs["env"])
+        self.assertEqual(json.loads(result.choices[0].message.content), {"rubric_passed": True})
