def collect_pending(run, sig):
    """Moves the pending files of the session that was handed off next to its HANDOFF.md, in arrival order."""
    src, dst = os.path.join(run, "pending"), os.path.join(os.path.dirname(sig["handoff"]), "pending")
    prefix = "pending-%s-" % safe(sig.get("session_id") or "")
    try:
        names = sorted(n for n in os.listdir(src) if n.startswith(prefix))
    except OSError:
        return []
    moved = []
    for n in names:
        try:
            os.makedirs(dst, exist_ok=True)
            os.replace(os.path.join(src, n), os.path.join(dst, n))
            moved.append(os.path.join(dst, n))
        except OSError as e:
            log("pending file %s not moved: %s" % (n, e))
    return moved


def new_session_prompt(sig):
    files = sig.get("pending") or []
    if len(files) > 12:
        which = "toate cele %d fișiere din %s, în ordinea numelui" % (len(files), os.path.dirname(files[0]))
    else:
        which = ", ".join(files)
    return ("Citește %s și urmează instrucțiunile din el. Sesiunea precedentă a fost oprită automat la ~%dk tokeni de "
            "context, ca lucrul să continue în această sesiune nouă. Excepție de la regula „răspunde și așteaptă”: după ce "
            "ai citit nota, reia imediat lucrul din punctul în care a rămas (ultimul lucru din transcript), fără să repeți "
            "acțiuni deja terminate. Dacă pasul următor este ireversibil sau cere decizia mea, oprește-te și întreabă.%s"
            % (sig["handoff"], int(sig.get("tokens") or 0) // 1000,
               " Citește și, în ordine, %s: conțin ultimele evenimente ale sesiunii precedente, încă nescrise în "
               "transcript (un eveniment împărțit în părți se citește în întregime)." % which if files else "")
            + " Aceasta este continuarea aceleiași sarcini, nu o cerere de rezumat al transferului. "
              "Păstrează cerințele utilizatorului pentru răspunsul final, inclusiv formatul exact. "
              "Dacă utilizatorul a cerut doar un anumit text, răspunsul final conține numai acel text, "
              "fără rezumat, explicații sau raport suplimentar despre transfer.")


def sticky_args(args):
    """The session-shaping flags of the first run, for the follow-up sessions (never a prompt, --resume, --continue).
    After `--` everything is prompt text."""
    kept, i = [], 0
    while i < len(args) and args[i] != "--":
        a = args[i]
        name, eq, _ = a.partition("=")
        if name in STICKY:
            n = STICKY[name]
            if n and eq:
                kept.append(a)
            elif n and i + 1 < len(args) and args[i + 1] != "--":
                kept += [a, args[i + 1]]
                i += 1
            elif not n:
                kept.append(a)
        i += 1
    return kept


def carry_session_flags(args, sig):
    """args with --model and --effort replaced by those of the closed session (sig); untouched when sig has neither.
    Only the flags before `--` are looked at."""
    carried = [(name, sig[key]) for name, key in (("--model", "model"), ("--effort", "effort")) if sig.get(key)]
    if not carried:
        return args
    names = {name for name, _ in carried}
    head, tail = (args[:args.index("--")], args[args.index("--"):]) if "--" in args else (args, [])
    kept, i = [], 0
    while i < len(head):
        name, eq, _ = head[i].partition("=")
        if name in names:
            i += 1 if eq or i + 1 >= len(head) else 2
            continue
        kept.append(head[i])
        i += 1
    return kept + [x for pair in carried for x in pair] + tail


def rule_args(*arglists):
    """The flag that appends VARIANT_RULE to the system prompt of every session of a run; none when CLAUDE_AUTO_RULE is
    off or any of the argument lists (the flags before `--`) already carries the user's own system prompt text."""
    if os.environ.get("CLAUDE_AUTO_RULE", "on").lower() in ("off", "0"):
        return []
    for args in arglists:
        head = args[:args.index("--")] if "--" in args else args
        if any(a.partition("=")[0] in OWN_SYSTEM_PROMPT for a in head):
            return []
    return ["--append-system-prompt", VARIANT_RULE]


def selects_session(args):
    """True when the flags before `--` pick the session to start from (--resume, --continue, ...)."""
    head = args[:args.index("--")] if "--" in args else args
    return any(a.partition("=")[0] in PICK_SESSION for a in head)


def without_session_pick(head):
    """head without the flags that pick a session, and their values: a follow-up session must not open the old one again."""
    kept, i = [], 0
    while i < len(head):
        name, eq, _ = head[i].partition("=")
        n = 0 if name == "--fork-session" else PICK_SESSION.get(name)
        if n is None:
            kept.append(head[i])
        elif not eq and i + 1 < len(head) and (n == 1 or n == 2 and not head[i + 1].startswith("-")):
            i += 1
        i += 1
    return kept


def session_args(args):
    """Keep every explicit session-shaping argument before `--`, except the ones that pick a session; callers with
    variadic flags must delimit the prompt."""
    if "--" not in args:
        return sticky_args(args)
    head, kept, i = without_session_pick(args[:args.index("--")]), [], 0
    while i < len(head):
        if head[i] == "--settings":
            i += 2
            continue
        if not head[i].startswith("--settings="):
            kept.append(head[i])
        i += 1
    return kept


def passthrough(args):
    head = args[:args.index("--")] if "--" in args else args
    return any(a in PASSTHROUGH_FLAGS for a in head) or (bool(head) and head[0] in SUBCOMMANDS)


def split_settings(args):
    """Takes --settings out of `args`. claude uses only the LAST --settings it gets, so one of the user's would silence the
    hooks claude-auto adds; the hooks are merged into it instead. Returns (args without it, its content or None, error)."""
    kept, value, i = [], None, 0
    while i < len(args):
        a = args[i]
        if a == "--":
            kept += args[i:]
            break
        name, eq, rest = a.partition("=")
        if name == "--settings" and eq:
            value = rest
        elif name == "--settings" and i + 1 < len(args) and args[i + 1] != "--":
            value = args[i + 1]
            i += 1
        else:
            kept.append(a)
        i += 1
    if value is None:
        return kept, None, None
    try:
        if value.lstrip().startswith("{"):
            data = json.loads(value)
        else:
            with open(os.path.expanduser(value), encoding="utf-8") as f:
                data = json.load(f)
        if not isinstance(data, dict) or not isinstance(data.get("hooks", {}), dict):
            raise ValueError("not a settings object")
    except (OSError, ValueError) as e:
        return args, None, "%s: %s" % (value[:60], e)
    return kept, data, None


def write_settings(path, user=None):
    """The settings file claude-auto passes with --settings: the hooks, merged into the user's own --settings if any."""
    command = "%s %s __hook" % (shlex.quote(sys.executable), shlex.quote(os.path.realpath(__file__)))
    hooks = [{"type": "command", "command": command, "timeout": 150}]
    ours = {"PreToolUse": [{"matcher": "*", "hooks": hooks}], "Stop": [{"hooks": hooks}], "PostToolUse": [{"matcher": "*", "hooks": hooks}],
            "SubagentStart": [{"hooks": hooks}], "SubagentStop": [{"hooks": hooks}]}
    data = dict(user or {})
    merged = dict(data.get("hooks") or {})
    for event, entries in ours.items():
        old = merged.get(event)
        merged[event] = (old if isinstance(old, list) else []) + entries
    data["hooks"] = merged
    with open(path, "w") as f:
        json.dump(data, f)


class Terminal:
    """claude puts the terminal in raw mode; a killed claude cannot undo it, so the wrapper does."""

    def __init__(self):
        self.fd, self.saved = None, None
        if termios and sys.stdin.isatty():
            try:
                self.fd, self.saved = sys.stdin.fileno(), termios.tcgetattr(sys.stdin.fileno())
            except termios.error:
                self.fd = None

    def restore(self, reset_modes):
        if self.fd is not None:
            try:
                termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)
            except termios.error:
                pass
        if reset_modes and sys.stdout.isatty():
            sys.stdout.write(TERMINAL_RESET)
            sys.stdout.flush()


class Child:
    proc = None
    stop = False
    stop_at = 0.0
    signum = 0


def on_term_signal(signum, frame):
    if not Child.stop:
        Child.stop, Child.stop_at, Child.signum = True, time.time(), signum
    if Child.proc and Child.proc.poll() is None:
        Child.proc.terminate()


def process_table():
    """pid -> (ppid, start time) of every process. The start time tells a reused pid from the one we saw."""
    out = subprocess.run(["ps", "-axo", "pid=,ppid=,lstart="], capture_output=True, text=True).stdout
    table = {}
    for line in out.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
            table[int(parts[0])] = (int(parts[1]), parts[2].strip())
    return table


def descendants(pid):
    """pid -> start time of everything below `pid`, found before it is ended (afterwards they are orphans)."""
    table, kids = process_table(), {}
    for p, (pp, _) in table.items():
        kids.setdefault(pp, []).append(p)
    found, todo = {}, [pid]
    while todo:
        for c in kids.get(todo.pop(), []):
            found[c] = table[c][1]
            todo.append(c)
    return found


def reap(found):
    """Ends what claude's tools left running after claude was ended (SIGTERM, then SIGKILL). Only processes that still have
    the start time we recorded; a reused pid is not touched."""
    for sig in (signal.SIGTERM, signal.SIGKILL):
        table = process_table()
        alive = [p for p, started in found.items() if p in table and table[p][1] == started]
        if not alive:
            return
        for p in alive:
            try:
                os.kill(p, sig)
            except OSError:
                pass
        if sig == signal.SIGTERM:
            time.sleep(env_num("CLAUDE_AUTO_REAP_WAIT", 1.0, float))


def end_claude(proc):
    below = descendants(proc.pid)
    proc.terminate()
    try:
        proc.wait(env_num("CLAUDE_AUTO_KILL_WAIT", 5.0, float))
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()
    reap(below)


def run_once(cmd, env, cwd, run):
    """Returns (exit code, signal). The signal is returned only if claude-auto ended claude because of it."""
    if Child.stop:
        return 128 + Child.signum, None          # we were asked to stop before this session started: do not start it
    proc = Child.proc = subprocess.Popen(cmd, env=env, cwd=cwd)
    if Child.stop:
        proc.terminate()                         # the signal came while Popen ran, when the handler saw no child yet
    poll, grace = env_num("CLAUDE_AUTO_POLL", 0.2, float), env_num("CLAUDE_AUTO_GRACE", 1.0, float)
    while True:
        try:
            return proc.wait(poll), None
        except subprocess.TimeoutExpired:
            pass
        if Child.stop:                           # SIGTERM was sent once by the handler; a claude that ignores it is killed
            if time.time() - Child.stop_at >= env_num("CLAUDE_AUTO_KILL_WAIT", 5.0, float):
                end_claude(proc)
                return proc.returncode, None
            continue
        sig = None
        if run:
            try:
                with open(os.path.join(run, "signal.json")) as f:
                    sig = json.load(f)
            except (OSError, ValueError):
                sig = None
        if sig:
            try:
                return proc.wait(grace), None        # the user quit by themselves: no new session
            except subprocess.TimeoutExpired:
                end_claude(proc)
                return proc.returncode, sig


def initial_prompt(args):
    if "--" in args:
        return " ".join(args[args.index("--") + 1:])
    out, i = [], 0
    while i < len(args):
        name, eq, _ = args[i].partition("=")
        if name in STICKY and STICKY[name] and not eq:
            i += 1
        elif not args[i].startswith("-"):
            out.append(args[i])
        i += 1
    return " ".join(out)


def close_cooperation(plugin, database, member, generation):
    """Closing membership must never change the wrapped process's exit status."""
    if not member or not generation:
        return
    try:
        subprocess.run(["python3", "-I", os.path.join(plugin, "scripts", "registry.py"), database],
                       input=json.dumps({"op": "close", "member": member, "generation": generation}),
                       text=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass


def wrapper(args):
    claude = shutil.which(os.environ.get("CLAUDE_AUTO_CLAUDE") or "claude")
    if not claude:
        say("claude not found in PATH")
        return 127
    claude = os.path.abspath(claude)             # a follow-up session may start in another directory
    if passthrough(args):
        os.execv(claude, [claude] + args)
    cooperation = os.environ.get("CLAUDE_AUTO_COOPERATE") == "1"
    plugin = database = member = None
    generation = 0
    if cooperation:
        plugin = os.path.join(os.path.dirname(os.path.realpath(__file__)), "cooperation")
        for required in (".claude-plugin/plugin.json", "hooks/hooks.json", "hooks/register.ts", "scripts/registry.py",
                         "types/index.d.ts"):
            if not os.path.isfile(os.path.join(plugin, required)):
                say("bundled cooperation plugin is missing %s; reinstall claude-auto; nothing was started" % required)
                return 2
        database = os.environ.get("CLAUDE_AUTO_COOP_DB") or os.path.expanduser("~/.claude/cooperation/registry.sqlite3")
        if not os.path.isabs(database):
            say("CLAUDE_AUTO_COOP_DB must be an absolute path; nothing was started")
            return 2
        member = str(uuid.uuid4())              # never reuse an inherited wrapper's identity
    try:
        env_next = shlex.split(os.environ["CLAUDE_AUTO_NEXT_ARGS"]) if "CLAUDE_AUTO_NEXT_ARGS" in os.environ else None
    except ValueError as e:
        say("CLAUDE_AUTO_NEXT_ARGS is not valid shell syntax (%s); nothing was started" % e)
        return 2
    first_args, user, err = split_settings(args)
    if env_next is None:
        next_args, next_user, nerr = session_args(first_args), user, None
    else:
        next_args, next_user, nerr = split_settings(env_next)
    for e in (err, nerr):
        if e:
            say("--settings %s cannot be merged with the claude-auto hooks; it overrides them in that session" % e)
    terminal, maximum = Terminal(), env_num("CLAUDE_AUTO_MAX", 0)
    try:
        os.makedirs(base_dir(), exist_ok=True)
        run = tempfile.mkdtemp(prefix="run-", dir=base_dir())
    except OSError as e:
        say("cannot create the run folder in %s (%s); nothing was started" % (base_dir(), e))
        return 1
    try:
        settings = os.path.join(run, "settings.json")
        write_settings(settings, user)
        settings_next = settings
        if env_next is not None:
            settings_next = os.path.join(run, "settings-next.json")
            write_settings(settings_next, next_user)
        plain = None
        if next_user:                            # after CLAUDE_AUTO_MAX handoffs the hooks go, the user's settings stay
            plain = os.path.join(run, "settings-plain.json")
            with open(plain, "w") as f:
                json.dump(next_user, f)
        signal.signal(signal.SIGINT, lambda *a: None)      # Ctrl-C goes to claude (same process group); a handler, not
        signal.signal(signal.SIGTERM, on_term_signal)      # SIG_IGN, which the child would inherit
        signal.signal(signal.SIGHUP, on_term_signal)
        rule = rule_args(first_args, next_args)      # decided once: the same system prompt in every session of the run
        anchor = os.environ.get("CLAUDE_AUTO_ANCHOR_ID")
        # The warm-up session would start a new one and drop the flags that pick the user's; then the first run is as typed.
        bootstrap = not bool(anchor) and os.environ.get("CLAUDE_AUTO_BOOTSTRAP", "1") != "0" and not selects_session(first_args)
        work_prompt = initial_prompt(first_args)
        handoffs, cwd, continuation = 0, None, False
        argv = next_args + ["--", "Răspunde exact: ANCHOR_READY"] if bootstrap else first_args
        while True:
            if Child.stop:
                return 128 + Child.signum
            hooked = not maximum or handoffs < maximum
            env = dict(os.environ)
            env.pop("CLAUDE_AUTO_RUN", None)
            env.pop("CLAUDE_AUTO_BOOTSTRAP", None)
            if hooked:
                env["CLAUDE_AUTO_RUN"] = run
            if bootstrap:
                env["CLAUDE_AUTO_BOOTSTRAP"] = "1"
            plugin_args = []
            if cooperation:
                for key in ("CLAUDE_AUTO_COOPERATE", "CLAUDE_AUTO_COOP_MEMBER", "CLAUDE_AUTO_COOP_GENERATION",
                            "CLAUDE_AUTO_COOP_DB", "CLAUDE_AUTO_COOP_CONTINUATION"):
                    env.pop(key, None)
                if not bootstrap:
                    generation += 1
                    env.update(CLAUDE_AUTO_COOPERATE="1", CLAUDE_AUTO_COOP_MEMBER=member,
                               CLAUDE_AUTO_COOP_GENERATION=str(generation), CLAUDE_AUTO_COOP_DB=database)
                    if continuation:
                        env["CLAUDE_AUTO_COOP_CONTINUATION"] = "1"
                    plugin_args = ["--plugin-dir", plugin]
            use = (settings if handoffs == 0 else settings_next) if hooked else plain
            cmd = [claude] + (["--settings", use] if use else []) + plugin_args + rule + argv
            rc, sig = run_once(cmd, env, cwd, run if hooked else None)
            # claude resets the terminal modes it set when it exits by itself; killed (by us, by a signal) it cannot
            terminal.restore(reset_modes=bool(sig) or Child.stop or rc < 0)
            if not sig or Child.stop:
                return rc if rc >= 0 else 128 - rc      # killed by a signal: 128 + signal, as a shell reports it
            os.remove(os.path.join(run, "signal.json"))
            if sig.get("kind") == "anchor":
                anchor, bootstrap = sig["session_id"], False
                with open(os.path.join(run, "anchor.json"), "w") as f:
                    json.dump({"anchor_session_id": anchor}, f)
                argv = next_args + ["--resume", anchor, "--fork-session", "--", work_prompt]
                continue
            shutil.rmtree(os.path.join(run, "agents"), ignore_errors=True)      # the subagents ended with that claude
            if os.path.exists(os.path.join(run, "deferred")):
                os.remove(os.path.join(run, "deferred"))
            sig["pending"] = collect_pending(run, sig)
            handoffs += 1
            if sig.get("cwd") and os.path.isdir(sig["cwd"]):
                cwd = sig["cwd"]
            fork = ["--resume", anchor, "--fork-session"] if anchor else []
            carried = next_args if env_next is not None else carry_session_flags(next_args, sig)      # an explicit CLAUDE_AUTO_NEXT_ARGS wins
            argv = carried + fork + ["--", new_session_prompt(sig)]      # `--`: a variadic option must not swallow the prompt
            continuation = True                    # only this explicit handoff prompt preserves the owner revision
            say("%dk tokeni de context; nota: %s. Pornesc sesiunea nouă în aceeași fereastră." % (
                int(sig.get("tokens") or 0) // 1000, sig["handoff"]))
            log("handoff %d: claude ended (exit %s), new session from %s (cwd %s, %d pending file(s))" % (
                handoffs, rc, sig["handoff"], cwd or os.getcwd(), len(sig["pending"])))
    except BaseException:
        terminal.restore(reset_modes=True)
        raise
    finally:
        close_cooperation(plugin, database, member, generation)
        shutil.rmtree(run, ignore_errors=True)


def main(argv):
    if argv[:1] == ["__hook"]:
        return hook_main()
    return wrapper(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
