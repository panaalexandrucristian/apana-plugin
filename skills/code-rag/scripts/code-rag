#!/bin/sh
# Runs code_rag.py with the python of the code-rag-setup venv; exit 3 when that venv is missing.
home="${CODE_RAG_HOME:-$HOME/.cache/code-rag}"
python="$home/venv/bin/python"
if [ ! -x "$python" ]; then
  echo "code-rag is not installed (no $python); run /apana:code-rag-setup first" >&2
  exit 3
fi
exec "$python" -I "$(dirname "$0")/code_rag.py" "$@"
